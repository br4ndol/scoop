{
    "version": "0.38.0",
    "description": "A native music streaming client, built with Rust and GPUI",
    "homepage": "https://sonorahq.org/",
    "license": "GPL-3.0-only",
    "architecture": {
        "64bit": {
            "url": "https://github.com/sonorahq/sonora/releases/download/v0.38.0/sonora-v0.38.0-x86_64-pc-windows-msvc.exe",
            "hash": "1ac2980d7b351670ec8bfe496f0207b714f2029fba65d0dceebf67634f6b5dcc"
        }
    },
    "pre_install": [
        "Get-ChildItem \"$dir\" -Filter \"sonora-*.exe\" | Rename-Item -NewName \"sonora.exe\""
    ],
    "post_install": [
        "if (!(Test-Path \"$persist_dir\\data\")) { New-Item -ItemType Directory -Path \"$persist_dir\\data\" -Force | Out-Null }",
        "if (Test-Path \"$env:LOCALAPPDATA\\sonora\") {",
        "    Copy-Item -Path \"$env:LOCALAPPDATA\\sonora\\*\" -Destination \"$persist_dir\\data\" -Force -Recurse",
        "    Remove-Item \"$env:LOCALAPPDATA\\sonora\" -Force -Recurse",
        "}",
        "New-Item -ItemType Junction -Path \"$env:LOCALAPPDATA\\sonora\" -Target \"$persist_dir\\data\" | Out-Null"
    ],
    "uninstaller": {
        "script": "if (Test-Path \"$env:LOCALAPPDATA\\sonora\") { Remove-Item \"$env:LOCALAPPDATA\\sonora\" -Force -Recurse }"
    },
    "bin": "sonora.exe",
    "shortcuts": [
        [
            "sonora.exe",
            "Sonora"
        ]
    ],
    "persist": "data",
    "checkver": {
        "url": "https://api.github.com/repos/sonorahq/sonora/releases",
        "jsonpath": "$[0].tag_name",
        "regex": "v?([\\d.]+)"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://github.com/sonorahq/sonora/releases/download/v$version/sonora-v$version-x86_64-pc-windows-msvc.exe"
            }
        }
    }
}