{
    "version": "1.3.353",
    "description": "A simple, experimental Nintendo Switch emulator (canary build).",
    "homepage": "https://ryujinx.app/",
    "license": {
        "identifier": "MIT",
        "url": "https://git.ryujinx.app/ryubing/ryujinx/raw/branch/master/LICENSE.txt"
    },
    "notes": [
        "ATTENTION: Ryujinx requires Nintendo Switch firmware and a prod.keys file to function.",
        "Learn more at https://git.ryujinx.app/ryubing/ryujinx/wiki/FAQ-&-Troubleshooting"
    ],
    "url": "https://git.ryujinx.app/ryubing/canary/releases/download/1.3.353/ryujinx-canary-1.3.353-win_x64.7z",
    "hash": "4b9b87cb8d0254996e0ca43a8bc117eb97201239a21ba1919379617265ad378e",
    "extract_dir": "publish",
    "pre_install": [
        "if (!(Test-Path \"$persist_dir\")) {",
        "    New-Item \"$persist_dir\\portable\" -ItemType Directory | Out-Null",
        "    if (Test-Path \"$env:APPDATA\\Ryujinx\") {",
        "        Write-Host \"Migrating AppData to portable directory...\" -ForegroundColor Yellow",
        "        Copy-Item -Path \"$env:APPDATA\\Ryujinx\\*\" -Destination \"$persist_dir\\portable\" -Recurse",
        "        Remove-Item -Path \"$env:APPDATA\\Ryujinx\" -Recurse",
        "    }",
        "}"
    ],
    "bin": [
        [
            "Ryujinx.exe",
            "ryujinx-canary"
        ]
    ],
    "shortcuts": [
        [
            "Ryujinx.exe",
            "Ryujinx (Canary)"
        ]
    ],
    "persist": "portable",
    "checkver": {
        "url": "https://git.ryujinx.app/api/v1/repos/ryubing/canary/releases",
        "jsonpath": "$[0].tag_name"
    },
    "autoupdate": {
        "url": "https://git.ryujinx.app/ryubing/canary/releases/download/$version/ryujinx-canary-$version-win_x64.7z"
    }
}
